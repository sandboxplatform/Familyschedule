# Copy to .env and adjust. Every value is optional.

# Sign-in needs no configuration: the first person to open the site creates
# the household account, and everyone after that is added from inside.

# Railway, Fly and friends inject PORT themselves; this is for local runs.
PORT=4321

# The database file. A volume mounted at /data, /var/hearth or /app/data is
# found on its own, so this is only for putting it somewhere else.
HEARTH_DATA=./data/calendar.db

# Set to "off" to start with an empty calendar instead of the demo household.
HEARTH_SEED=
